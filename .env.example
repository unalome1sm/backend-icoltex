
MONGODB_URI=
MONGODB_DB_NAME=

# Server Configuration
PORT=

# CORS: orígenes del frontend (coma, sin espacios o con espacios si tu parser los recorta).
# Incluye el dominio de Vercel para que fetch desde el navegador funcione con NEXT_PUBLIC_API_URL.
CORS_ORIGINS=http://localhost:3000,https://frontend-icoltex.vercel.app

# Environment
NODE_ENV=development

# API Icoltex (webhook - Basic Auth). Solo la base; los endpoints se definen en config.
ICOLTEX_API_URL=
ICOLTEX_API_USER=
ICOLTEX_API_PASSWORD=

# Webhook Tangara: catálogo vitrina agrupado (GET info-items-x-ref). Requiere Basic Auth.
ICOLTEX_CARACTERISTICAS_WEBHOOK_URL=https://webhook-icoltex.tangara.cloud/webhook/info-items-x-ref

# Auth (JWT y sesión)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# SMTP (Nodemailer) para códigos OTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# OTP
AUTH_OTP_TTL_MINUTES=10
AUTH_OTP_RESEND_SECONDS=60

# Google Sign-In (OAuth 2.0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Drive API (Service Account — solo backend)
# 1. Crear Service Account en Google Cloud
# 2. Compartir la carpeta de Drive con el email de la Service Account (rol Lector)
# 3. Carpeta PAGINA ICOLTEX: https://drive.google.com/drive/folders/15qfWHVlpLwV3nnUD7YWybEfUPKrhh8NT
GOOGLE_DRIVE_FOLDER_ID=15qfWHVlpLwV3nnUD7YWybEfUPKrhh8NT
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
